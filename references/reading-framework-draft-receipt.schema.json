{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/industry-research-reading-framework-draft-receipt-0.1.json",
  "title": "Reading Framework Draft Receipt",
  "description": "A content-free receipt recording the declared chronology in which a draft was hashed after the reading framework was frozen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "run_id",
    "evaluation_group",
    "framework_id",
    "framework_hash",
    "framework_created_at",
    "prior_manifest_id",
    "prior_manifest_hash",
    "support_bundle_id",
    "support_bundle_hash",
    "draft_ingested_at",
    "draft_sha256",
    "draft_bytes",
    "draft_content_logged",
    "draft_path_logged",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "receipt_id": {"type": "string", "pattern": "^RFR-[A-F0-9]{20}$"},
    "run_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "evaluation_group": {"enum": ["E", "F"]},
    "framework_id": {"type": "string", "pattern": "^RFM-[A-F0-9]{20}$"},
    "framework_hash": {"$ref": "#/$defs/sha256"},
    "framework_created_at": {"type": "string", "format": "date-time"},
    "prior_manifest_id": {"type": "string"},
    "prior_manifest_hash": {"$ref": "#/$defs/sha256"},
    "support_bundle_id": {"type": ["string", "null"]},
    "support_bundle_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "draft_ingested_at": {"type": "string", "format": "date-time"},
    "draft_sha256": {"$ref": "#/$defs/sha256"},
    "draft_bytes": {"type": "integer", "minimum": 0},
    "draft_content_logged": {"const": false},
    "draft_path_logged": {"const": false},
    "receipt_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
