{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/industry-research-reading-framework-manifest-0.1.json",
  "title": "Industry Research Reading Framework Manifest",
  "description": "A hash-bound E/F reading framework with a declared pre-draft chronology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework_id",
    "run_id",
    "evaluation_group",
    "task_envelope_id",
    "task_envelope_hash",
    "topic_brief_id",
    "topic_brief_hash",
    "prior_manifest_id",
    "prior_manifest_hash",
    "support_bundle_id",
    "support_bundle_hash",
    "framework_plan_id",
    "framework_plan_hash",
    "authorization_ref",
    "authorization_snapshot_hash",
    "authorization_checked_at",
    "authorization_purpose",
    "authorization_processor_class",
    "authorization_output_audience",
    "selection_policy_version",
    "created_at",
    "draft_seen",
    "routing_source",
    "input_roles",
    "semantic_framework",
    "linkage",
    "character_budget",
    "budget_closure_code",
    "budget_issues",
    "privacy",
    "framework_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "framework_id": {"type": "string", "pattern": "^RFM-[A-F0-9]{20}$"},
    "run_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "evaluation_group": {"enum": ["E", "F"]},
    "task_envelope_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "task_envelope_hash": {"$ref": "#/$defs/sha256"},
    "topic_brief_id": {"type": "string", "pattern": "^TB-[A-Z0-9-]{3,64}$"},
    "topic_brief_hash": {"$ref": "#/$defs/sha256"},
    "prior_manifest_id": {"type": "string", "pattern": "^PM-[A-F0-9]{20}$"},
    "prior_manifest_hash": {"$ref": "#/$defs/sha256"},
    "support_bundle_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^ESB-[A-F0-9]{20}$"}
      ]
    },
    "support_bundle_hash": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "framework_plan_id": {"type": "string", "pattern": "^RFP-[A-Z0-9-]{3,64}$"},
    "framework_plan_hash": {"$ref": "#/$defs/sha256"},
    "authorization_ref": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,127}$"},
    "authorization_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "authorization_checked_at": {"type": "string", "format": "date-time"},
    "authorization_purpose": {"const": "local-review"},
    "authorization_processor_class": {"const": "model_context_abstract"},
    "authorization_output_audience": {"const": "private_review"},
    "selection_policy_version": {"const": "reading-framework-strict-budget-v0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "draft_seen": {"const": false},
    "routing_source": {
      "enum": [
        "task_metadata_topic_and_prior_only",
        "task_metadata_topic_prior_and_support"
      ]
    },
    "input_roles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "semantic_framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_question", "nodes", "framework_limits", "eligible_as_evidence"],
      "properties": {
        "research_question": {"type": "string", "minLength": 1, "maxLength": 1024},
        "nodes": {"type": "array", "minItems": 1, "maxItems": 96, "items": {"$ref": "#/$defs/node"}},
        "framework_limits": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "eligible_as_evidence": {"const": false}
      }
    },
    "linkage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_question_ids", "support_item_ids_used"],
      "properties": {
        "prior_question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "support_item_ids_used": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "character_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "max_plan_chars", "max_framework_chars", "actual_plan_chars", "actual_framework_chars"],
      "properties": {
        "metric": {"const": "canonical-json-unicode-code-points-v1"},
        "max_plan_chars": {"type": "integer", "minimum": 1, "maximum": 32768},
        "max_framework_chars": {"type": "integer", "minimum": 1, "maximum": 49152},
        "actual_plan_chars": {"type": "integer", "minimum": 1},
        "actual_framework_chars": {"type": "integer", "minimum": 1}
      }
    },
    "budget_closure_code": {"const": "FRAMEWORK_BUDGET_WITHIN_LIMIT"},
    "budget_issues": {"type": "array", "maxItems": 0},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["private_review_only", "draft_content_logged", "draft_path_logged", "source_locations_omitted", "framework_is_not_evidence"],
      "properties": {
        "private_review_only": {"const": true},
        "draft_content_logged": {"const": false},
        "draft_path_logged": {"const": false},
        "source_locations_omitted": {"const": true},
        "framework_is_not_evidence": {"const": true}
      }
    },
    "framework_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "prompt", "prior_question_refs", "support_item_refs"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^RFN-[A-Z0-9-]{3,64}$"},
        "node_type": {
          "enum": [
            "baseline_hypothesis",
            "definition_boundary",
            "variable",
            "actor_decision",
            "mechanism_chain",
            "alternative_hypothesis",
            "expected_evidence",
            "falsifier",
            "must_check",
            "blind_spot"
          ]
        },
        "prompt": {"type": "string", "minLength": 1, "maxLength": 2048},
        "prior_question_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^PQ-[A-Z][A-Z0-9-]{2,63}$"}},
        "support_item_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ESI-[A-F0-9]{20}$"}}
      }
    }
  }
}
