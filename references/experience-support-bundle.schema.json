{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/experience-support-bundle-0.1.json",
  "title": "Experience Support Bundle",
  "description": "A private sidecar bound to an existing PriorQuestionManifest. It exposes lineage and support limits, never fact evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "run_id",
    "prior_manifest_id",
    "prior_manifest_hash",
    "task_envelope_hash",
    "knowledge_snapshot_hash",
    "source_manifest_snapshot_hash",
    "authorization_snapshot_hash",
    "authorization_ref",
    "processor_class",
    "selection_policy_version",
    "created_at",
    "source_asset_verification",
    "support_items",
    "coverage",
    "character_budget",
    "budget_closure_code",
    "budget_issues",
    "privacy",
    "bundle_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "bundle_id": {"type": "string", "pattern": "^ESB-[A-F0-9]{20}$"},
    "run_id": {"type": "string", "minLength": 1},
    "prior_manifest_id": {"type": "string", "pattern": "^PM-[A-F0-9]{20}$"},
    "prior_manifest_hash": {"$ref": "#/$defs/sha256"},
    "task_envelope_hash": {"$ref": "#/$defs/sha256"},
    "knowledge_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "source_manifest_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "authorization_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "authorization_ref": {"type": "string", "minLength": 1},
    "processor_class": {"enum": ["local_deterministic", "model_context_abstract"]},
    "selection_policy_version": {"const": "prior-question-experience-support-v0.1"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_asset_verification": {"$ref": "#/$defs/sourceAssetVerification"},
    "support_items": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/supportItem"}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_question_count",
        "eligible_item_count",
        "selected_item_count",
        "omitted_item_count",
        "omissions"
      ],
      "properties": {
        "prior_question_count": {"type": "integer", "minimum": 0},
        "eligible_item_count": {"type": "integer", "minimum": 0},
        "selected_item_count": {"type": "integer", "minimum": 0},
        "omitted_item_count": {"type": "integer", "minimum": 0},
        "omissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prior_question_id", "code"],
            "properties": {
              "prior_question_id": {"type": "string", "pattern": "^PQ-[A-Z][A-Z0-9-]{2,63}$"},
              "code": {"$ref": "#/$defs/budgetIssueCode"}
            }
          }
        }
      }
    },
    "character_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "max_source_refs_per_item",
        "max_locator_refs_per_item",
        "max_transformations_per_item",
        "max_item_chars",
        "max_bundle_chars"
      ],
      "properties": {
        "metric": {"const": "canonical-json-unicode-code-points-v1"},
        "max_source_refs_per_item": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_locator_refs_per_item": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_transformations_per_item": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_item_chars": {"type": "integer", "minimum": 1, "maximum": 2048},
        "max_bundle_chars": {"type": "integer", "minimum": 1, "maximum": 16384}
      }
    },
    "budget_closure_code": {
      "enum": ["SUPPORT_BUDGET_WITHIN_LIMIT", "SUPPORT_BUDGET_TRUNCATED_TO_LIMIT"]
    },
    "budget_issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "count"],
        "properties": {
          "code": {"$ref": "#/$defs/budgetIssueCode"},
          "count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_review_only",
        "source_bodies_not_included",
        "source_paths_omitted",
        "stdout_metadata_only",
        "origin_trace_is_not_truth_evidence"
      ],
      "properties": {
        "private_review_only": {"const": true},
        "source_bodies_not_included": {"const": true},
        "source_paths_omitted": {"const": true},
        "stdout_metadata_only": {"const": true},
        "origin_trace_is_not_truth_evidence": {"const": true}
      }
    },
    "bundle_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "budgetIssueCode": {
      "enum": [
        "SUPPORT_SOURCE_REF_LIMIT_OMITTED",
        "SUPPORT_LOCATOR_REF_LIMIT_OMITTED",
        "SUPPORT_TRANSFORMATION_LIMIT_OMITTED",
        "SUPPORT_ITEM_CHAR_LIMIT_OMITTED",
        "SUPPORT_BUNDLE_CHAR_LIMIT_OMITTED"
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "declared_source_sha256"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,127}$"},
        "source_type": {"type": "string", "minLength": 1},
        "declared_source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourceVerificationStatus": {
      "enum": ["manifest_declared_not_verified", "byte_hash_verified"]
    },
    "sourceAssetVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "declared_source_count",
        "byte_verified_source_count",
        "hash_algorithm"
      ],
      "properties": {
        "status": {"$ref": "#/$defs/sourceVerificationStatus"},
        "declared_source_count": {"type": "integer", "minimum": 0},
        "byte_verified_source_count": {"type": "integer", "minimum": 0},
        "hash_algorithm": {"const": "sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "manifest_declared_not_verified"}},
            "required": ["status"]
          },
          "then": {"properties": {"byte_verified_source_count": {"const": 0}}}
        }
      ]
    },
    "supportItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_item_id",
        "prior_question_id",
        "knowledge_card_id",
        "knowledge_card_hash",
        "card_type",
        "sensitivity",
        "origin_type",
        "origin_trace_status",
        "source_asset_verification_status",
        "locator_verification_status",
        "origin_source_refs",
        "origin_locator_refs",
        "transformation_chain",
        "independent_source_refs",
        "support_level",
        "independence_status",
        "declared_epistemic",
        "epistemic_ceiling",
        "truth_status",
        "fact_use_requires_separate_verification",
        "human_review_required",
        "knowledge_role",
        "eligible_as_fact_evidence"
      ],
      "properties": {
        "support_item_id": {"type": "string", "pattern": "^ESI-[A-F0-9]{20}$"},
        "prior_question_id": {"type": "string", "pattern": "^PQ-[A-Z][A-Z0-9-]{2,63}$"},
        "knowledge_card_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
        "knowledge_card_hash": {"$ref": "#/$defs/sha256"},
        "card_type": {"enum": ["expert_heuristic", "control"]},
        "sensitivity": {"enum": ["public", "restricted", "private"]},
        "origin_type": {"type": "string", "minLength": 1},
        "origin_trace_status": {"$ref": "#/$defs/sourceVerificationStatus"},
        "source_asset_verification_status": {"$ref": "#/$defs/sourceVerificationStatus"},
        "locator_verification_status": {"const": "declared_not_reproduced"},
        "origin_source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "origin_locator_refs": {"$ref": "#/$defs/stringArray"},
        "transformation_chain": {"$ref": "#/$defs/stringArray"},
        "independent_source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "support_level": {
          "enum": ["origin_trace_only", "origin_trace_with_declared_independent_leads"]
        },
        "independence_status": {"enum": ["none_declared", "declared_not_verified"]},
        "declared_epistemic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "fact_inference_boundary", "confidence"],
          "properties": {
            "status": {"enum": ["reported", "verified", "corroborated", "disputed"]},
            "fact_inference_boundary": {
              "enum": ["fact", "calculation", "inference", "opinion", "prediction", "reported_statement"]
            },
            "confidence": {"enum": ["low", "medium", "high"]}
          }
        },
        "epistemic_ceiling": {"const": "review_prompt_only"},
        "truth_status": {"const": "not_established_by_origin_trace"},
        "fact_use_requires_separate_verification": {"const": true},
        "human_review_required": {"const": true},
        "knowledge_role": {"const": "experience_support_metadata"},
        "eligible_as_fact_evidence": {"const": false}
      }
    }
  }
}
